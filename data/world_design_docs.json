  "_meta": {
    "purpose": "Per-world design documents that drive blueprint-based level generation for levels 61-90. Authored first, approved by the designer, then consumed by worldBuilder.js (buildBlueprint -> buildLevelFromBlueprint). This is the 'design document before generating a world' step.",
    "constraintsRef": "plans/generated_worlds_project_summary.md (27 core design constraints)",
    "indexMapping": "levelIndex = 61 + world*3 + difficulty;  difficulty 0/1/2 = tier I/II/III",
    "slotRoles": "intro (safe accel runway), signature (the biome's defining set-piece), filler (transition/variety from real pool chunks = detail-fill), climax (hardest moment, usually before final third), outro (safe finish runway)",
    "slotTagLegend": {
      "realPoolTags": [
        "runway",
        "slalom",
        "jump",
        "narrow_passage",
        "tunnel",
        "obstacle_course",
        "hazard_zone",
        "mixed"
      ],
      "customSetPieceTags": {
        "drift_curve": "sweeping S-curve with guardrails (slalom on slippery for tundra)",
        "tiered_hill": "multi-tier ramp-up hill with obstacles + hidden boosts behind them",
        "launch_jump": "ramp to launch peak, boost, void gap, refill landing",
        "floating_islands": "low-gravity island hops over gaps",
        "burn_chain": "burn-zone with safe center lane + boost chain",
        "gate_run": "rhythmic timing gates with one open lane (sticky brakes for pulse)",
        "bumper_canyon": "wide frictionless lane bounded by half-wall bumpers",
        "speed_chain": "wide track with chained boost pads, minimal walls",
        "tunnel_guided": "tunnel run with half-wall guide rails on edges"
      },
      "rule": "signature slots are filled from CUSTOM pool segments (source:'custom', biome-matched); filler slots are filled from REAL extracted chunks (detail-fill only)"
    },
    "notesKey": "telegraph=slope/marker precedes hazard; safeLanding=>=3 flat clean rows after gap; riskReward=boost on edge/before gap; rhythm=walls snapped to wallSpacing multiples; trap=fire in front of easiest line to refill; altRoute=slow-safe vs fast-dangerous"
  },
